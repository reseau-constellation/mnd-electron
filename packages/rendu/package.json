{
  "name": "@constl/mandataire-electron-rendu",
  "version": "3.1.3",
  "description": "Pour utiliser Constellation dans le processus rendu d'Électron. Doit être utilisé conjointement avec @constl/mandataire-electron-principal.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "nettoyer": "rimraf dist",
    "compiler": "pnpm versioner && pnpm nettoyer && pnpm tspc -p tsconfig.build.json",
    "test": "echo \"Error: no test specified\" && exit 0",
    "couverture": "pnpm test -- --coverage",
    "couverture:tous": "pnpm test:tous -- --coverage --bail",
    "formatter": "pnpm prettier --write \"**/*.+(js|ts|json)\" && pnpm eslint src",
    "prepublish": "pnpm versioner && pnpm compiler",
    "versioner": "pnpm genversion  --es6 --semi src/version.ts"
  },
  "keywords": [],
  "author": "Julien Malard-Adam",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@constl/mandataire": "^3.0.3",
    "events": "^3.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@constl/ipa": "^1.5.12",
    "@constl/mandataire-electron-principal": "workspace:^",
    "@eslint/js": "^9.20.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "genversion": "^3.2.0",
    "prettier": "^3.5.1",
    "prettier-plugin-organize-imports": "^4.1.0",
    "rimraf": "^6.0.1",
    "ts-patch": "^3.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.24.0",
    "typescript-transform-paths": "^3.5.3"
  },
  "gitHead": "685c2d66c3509fbff802c25985478938ad178956"
}
